{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "revision",
          "producer",
          "observedAt",
          "required",
          "role",
          "description",
          "specs"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^statecrafting/[a-z][a-z0-9-]+$"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "producer": {
            "const": "0.28.0"
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "required": {
            "const": true
          },
          "role": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "specs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "summary",
                "lifecycle",
                "implementation",
                "contentHash",
                "headings",
                "anchors",
                "claims",
                "relationships",
                "verification",
                "qualification",
                "sourceUrl"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "lifecycle": {
                  "enum": [
                    "draft",
                    "approved",
                    "superseded",
                    "retired"
                  ]
                },
                "implementation": {
                  "enum": [
                    "pending",
                    "in-progress",
                    "complete",
                    "n-a",
                    "deferred",
                    "unknown"
                  ]
                },
                "contentHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "headings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "anchors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "claims": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "unit"
                    ],
                    "properties": {
                      "kind": {
                        "type": "string"
                      },
                      "unit": {}
                    }
                  }
                },
                "relationships": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dependsOn",
                    "dependedOnBy",
                    "amends",
                    "amendedBy",
                    "supersedes",
                    "supersededBy"
                  ],
                  "properties": {
                    "dependsOn": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "dependedOnBy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "amends": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "amendedBy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "supersedes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "supersededBy": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                },
                "verification": {
                  "const": "unknown"
                },
                "qualification": {
                  "const": "unknown"
                },
                "sourceUrl": {
                  "type": "string",
                  "pattern": "^https://github.com/statecrafting/"
                }
              }
            }
          }
        }
      }
    }
  }
}
